{
    "name": "coverzen/sns-fanout-notification",
    "description": "package-description",
    "type": "package",
    "license": "MIT",
    "authors": [
        {
            "name": "Francesco Giovannini",
            "email": "francesco.giovannini@coverzen.it",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "aws/aws-sdk-php": "^3.353",
        "illuminate/notifications": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.9",
        "friendsofphp/php-cs-fixer": "^3.87.0",
        "larastan/larastan": "^3.0",
        "nunomaduro/phpinsights": "^2.11",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8",
        "phpmd/phpmd": "^2.15",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "povils/phpmnd": "^3.4",
        "psalm/plugin-laravel": "^3.0",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^3.9",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Coverzen\\Components\\SnsFanoutNotification\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Coverzen\\Components\\SnsFanoutNotification\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Coverzen\\Components\\SnsFanoutNotification\\SnsFanoutNotificationServiceProvider"
            ]
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "analyse": [
            "@php-cs-fixer",
            "@phpcs",
            "@phpinsights",
            "@phpmd",
            "@phpmnd",
            "@phpmnd-test",
            "@phpstan",
            "@psalm"
        ],
        "php-cs-fixer": "./vendor/bin/php-cs-fixer fix --dry-run --diff --ansi",
        "php-cs-fixer-fix": "./vendor/bin/php-cs-fixer fix",
        "phpcbf": "./vendor/bin/phpcbf",
        "phpcs": "./vendor/bin/phpcs",
        "phpinsights": "./vendor/bin/phpinsights -n",
        "phpmd": "./vendor/bin/phpmd --cache src,tests text phpmd.xml",
        "phpmnd": "./vendor/bin/phpmnd --extensions=all,-property,-argument,-array --strings --allow-array-mapping src",
        "phpmnd-test": "./vendor/bin/phpmnd --extensions=all,-property,-argument,-array --allow-array-mapping tests",
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=1G",
        "psalm": "./vendor/bin/psalm",
        "test": "./vendor/bin/pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
